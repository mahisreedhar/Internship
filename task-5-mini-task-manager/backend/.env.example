# Copy this file to .env and fill in production values.
# The app reads these via pydantic-settings.

# REQUIRED in production: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=dev-only-secret-key-change-this-in-production-min-32-chars!!

# JWT expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — swap to PostgreSQL for production
# DATABASE_URL=postgresql://user:password@localhost:5432/taskmanager
DATABASE_URL=sqlite:///./task_manager.db

# Frontend origin for CORS — no trailing slash
FRONTEND_ORIGIN=http://localhost:5173
